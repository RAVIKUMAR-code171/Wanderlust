<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WanderLust</title>
  </head>
  <body>
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings">
      <input name="listing[title]" placeholder="enter title" type="text" />
      <br /><br />
      <textarea
        name="listing[description]"
        placeholder="enter description"
      ></textarea>
      <br /><br />
      <input
        name="listing[image]"
        placeholder="enter image URL/Link"
        type="text"
      />
      <br /><br />
      <input name="listing[price]" placeholder="enter price" type="number" />
      <br /><br />
      <input name="listing[country]" placeholder="enter country" type="text" />
      <br /><br />
      <input
        name="listing[location]"
        placeholder="enter location"
        type="text"
      />
      <br /><br />
      <button>Add</button>
    </form>
    <footer>
      <p>
        Built by Ravi Kumar &middot;
        <a href="https://github.com/RAVIKUMAR-code171/Wanderlust">GitHub</a> &middot;
        <a href="https://www.linkedin.com/in/ravi-kumar-11b326286/">LinkedIn</a>
      </p>
    </footer>
  </body>
</html>
