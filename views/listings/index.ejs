<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WanderLust</title>
  </head>
  <body>
    <h3>All Listings</h3>
    <form method="GET" action="/listings/new">
      <button>Create New Listing</button>
    </form>
    <ul>
      <% for(let listing of allListings) { %>
      <li><a href="/listings/<%= listing._id %>"> <%= listing.title %> </a></li>
      <% } %>
    </ul>
    <footer>
      <p>
        Built by Ravi Kumar &middot;
        <a href="https://github.com/RAVIKUMAR-code171/Wanderlust">GitHub</a> &middot;
        <a href="https://www.linkedin.com/in/ravi-kumar-11b326286/">LinkedIn</a>
      </p>
    </footer>
  </body>
</html>
